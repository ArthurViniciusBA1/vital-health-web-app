NEXT_PUBLIC_FIREBASE_API_KEY= # 🔑 Chave da API do Firebase (disponível nas configurações do projeto)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= # 🌐 Domínio de autenticação (ex: projeto.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_PROJECT_ID= # 🆔 ID do projeto Firebase (ex: db-nome-do-projeto)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET= # 🗂️ URL do bucket de storage (ex: projeto.appspot.com)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= # 📲 ID de envio de mensagens (geralmente um número)
NEXT_PUBLIC_FIREBASE_APP_ID= # 📦 ID único do app Firebase (começa com 1:...)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID= # 📊 ID do Google Analytics (ex: G-XXXXXXX)
